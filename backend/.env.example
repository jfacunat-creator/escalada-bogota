# Base de datos PostgreSQL
DATABASE_URL="postgresql://usuario:password@localhost:5432/escalada_bogota?schema=public"

# JWT
JWT_SECRET="cambiar-por-un-secreto-seguro-de-64-caracteres-minimo"
JWT_EXPIRES_IN="7d"
JWT_REFRESH_EXPIRES_IN="30d"

# Servidor
PORT=3001
NODE_ENV=development

# Frontend URL (CORS)
FRONTEND_URL="http://localhost:5173"

# n8n (capa de AI). El admin ejecuta la actualización semanal desde n8n, que pide el lote a este backend.
# Mismo valor en la credencial Header Auth (X-Webhook-Secret) del flujo. Vacío = n8n no puede pedir lotes.
N8N_WEBHOOK_SECRET=""
