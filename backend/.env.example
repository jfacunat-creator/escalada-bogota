# Base de datos PostgreSQL
DATABASE_URL="postgresql://usuario:password@localhost:5432/escalada_bogota?schema=public"

# JWT
JWT_SECRET="cambiar-por-un-secreto-seguro-de-64-caracteres-minimo"
JWT_EXPIRES_IN="7d"
JWT_REFRESH_EXPIRES_IN="30d"

# Servidor
PORT=3001
NODE_ENV=development

# Frontend URL (CORS)
FRONTEND_URL="http://localhost:5173"

# n8n (capa de AI). Vacías = la integración queda apagada.
N8N_WEBHOOK_URL=""          # https://<tu-n8n>/webhook/generar-plan
N8N_WEBHOOK_AJUSTE_URL=""   # https://<tu-n8n>/webhook/ajustar-sesion
N8N_WEBHOOK_SECRET=""       # mismo valor en la Header Auth de ambos webhooks en n8n
