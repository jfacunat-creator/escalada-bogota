# Base de datos PostgreSQL
DATABASE_URL="postgresql://usuario:password@localhost:5432/escalada_bogota?schema=public"

# JWT
JWT_SECRET="cambiar-por-un-secreto-seguro-de-64-caracteres-minimo"
JWT_EXPIRES_IN="7d"
JWT_REFRESH_EXPIRES_IN="30d"

# Servidor
PORT=3001
NODE_ENV=development

# Frontend URL (CORS)
FRONTEND_URL="http://localhost:5173"

# n8n (capa de AI). Vacías = la integración queda apagada. Ver n8n/README.md
N8N_WEBHOOK_URL=""          # https://<tu-n8n>/webhook/ajustes-ai
N8N_WEBHOOK_SECRET=""       # mismo valor en la Header Auth del flujo en n8n
BACKEND_PUBLIC_URL=""       # URL de este backend vista desde n8n (local con Docker: http://host.docker.internal:3001)
