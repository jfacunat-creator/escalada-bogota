{
  "name": "escalada-bogota · Actualización semanal de planes (AI)",
  "nodes": [
    {
      "parameters": {},
      "name": "Ejecutar actualización",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "id": "1901cf8e-c118-45d8-8cbd-84e4e0d72b27",
      "position": [
        0,
        200
      ]
    },
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "weeks",
              "triggerAtDay": [
                1
              ],
              "triggerAtHour": 6
            }
          ]
        }
      },
      "name": "Cada lunes 6 a. m. (opcional)",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "id": "5d6d5d55-917b-4ea8-b11d-2d47c004118e",
      "position": [
        0,
        400
      ],
      "disabled": true
    },
    {
      "parameters": {
        "jsCode": "// URL del backend al que se le pide el lote y se devuelven las respuestas.\n// Producción: https://escalada-bogota.onrender.com · Local: http://host.docker.internal:3001\nreturn [{ json: { apiBase: 'https://escalada-bogota.onrender.com' } }];"
      },
      "name": "Configuración",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "id": "8639c111-709f-4f7a-9e85-c23e441fd7d4",
      "position": [
        240,
        300
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $json.apiBase }}/api/ajustes-ai/n8n/lote-semanal",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {
          "timeout": 180000
        }
      },
      "name": "Pedir lote semanal",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "id": "82a3a631-01a2-4f41-a74f-59a79ceee4a9",
      "position": [
        480,
        300
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "CONFIGURAR",
          "name": "escalada-bogota webhook secret"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "// Una consulta por item. El backend ya armó cada request completo (guía + fuentes + datos);\n// este flujo no lo modifica: solo lo envía a Claude y devuelve la respuesta.\nconst { apiBase } = $('Configuración').first().json;\nconst lote = $input.first().json;\nreturn (lote.tareas || []).map(t => ({ json: { apiBase, meta: t.meta, firma: t.firma, request: t.request } }));"
      },
      "name": "Separar consultas",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "id": "44cdd807-698b-4cf4-b1b8-7468f53727e4",
      "position": [
        720,
        300
      ]
    },
    {
      "parameters": {
        "batchSize": 1,
        "options": {}
      },
      "name": "Una a la vez",
      "type": "n8n-nodes-base.splitInBatches",
      "typeVersion": 3,
      "id": "21de327e-4226-41a6-9839-1fc8594f1152",
      "position": [
        1200,
        300
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.anthropic.com/v1/messages",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "anthropicApi",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "anthropic-version",
              "value": "2023-06-01"
            },
            {
              "name": "anthropic-beta",
              "value": "server-side-fallback-2026-07-01"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json.request) }}",
        "options": {
          "timeout": 600000,
          "response": {
            "response": {
              "neverError": true
            }
          }
        }
      },
      "name": "Claude",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "id": "62f70a9f-c44b-4ffd-9c26-a94962f7a6f3",
      "position": [
        1440,
        420
      ],
      "credentials": {
        "anthropicApi": {
          "id": "CONFIGURAR",
          "name": "Anthropic"
        }
      }
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $('Una a la vez').item.json.apiBase }}/api/ajustes-ai/n8n/resultado",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ meta: $('Una a la vez').item.json.meta, firma: $('Una a la vez').item.json.firma, respuesta: $json }) }}",
        "options": {
          "timeout": 60000
        }
      },
      "name": "Devolver al backend",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "id": "3d2b2434-0c4d-4fca-9ca5-a3f4d44b8968",
      "position": [
        1680,
        420
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "CONFIGURAR",
          "name": "escalada-bogota webhook secret"
        }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000
    }
  ],
  "settings": {
    "executionOrder": "v1"
  },
  "active": false,
